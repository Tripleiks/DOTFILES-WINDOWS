{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "version": 3,
  "final_space": true,
  "console_title_template": "{{ .Folder }}",
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "os",
          "style": "diamond",
          "leading_diamond": "",
          "trailing_diamond": "",
          "foreground": "#26C6DA",
          "background": "#1F2430",
          "template": " {{ if .WSL }}WSL {{ end }}{{.Icon}} "
        },
        {
          "type": "session",
          "style": "powerline",
          "powerline_symbol": "",
          "foreground": "#FFE082",
          "background": "#2E3440",
          "template": " {{ .UserName }} "
        },
        {
          "type": "path",
          "style": "powerline",
          "powerline_symbol": "",
          "foreground": "#FFFFFF",
          "background": "#3B4252",
          "properties": {
            "style": "agnoster_short",
            "max_depth": 3,
            "folder_separator_icon": "  ",
            "home_icon": ""
          },
          "template": " {{ .Path }} "
        },
        {
          "type": "git",
          "style": "powerline",
          "powerline_symbol": "",
          "foreground": "#1F2430",
          "background": "#A3BE8C",
          "background_templates": [
            "{{ if or (.Working.Changed) (.Staging.Changed) }}#EBCB8B{{ end }}",
            "{{ if and (gt .Ahead 0) (gt .Behind 0) }}#BF616A{{ end }}",
            "{{ if gt .Ahead 0 }}#88C0D0{{ end }}",
            "{{ if gt .Behind 0 }}#B48EAD{{ end }}"
          ],
          "properties": {
            "branch_icon": " ",
            "fetch_status": true,
            "fetch_upstream_icon": true,
            "fetch_worktree_count": true
          },
          "template": " {{ .UpstreamIcon }}{{ .HEAD }}{{if .BranchStatus }} {{ .BranchStatus }}{{ end }}{{ if .Working.Changed }}  {{ .Working.String }}{{ end }}{{ if and (.Staging.Changed) (.Working.Changed) }} |{{ end }}{{ if .Staging.Changed }}  {{ .Staging.String }}{{ end }}{{ if gt .StashCount 0 }}  {{ .StashCount }}{{ end }} "
        },
        {
          "type": "node",
          "style": "powerline",
          "powerline_symbol": "",
          "foreground": "#1F2430",
          "background": "#8FBCBB",
          "template": "  {{ .Full }} ",
          "properties": { "fetch_version": true, "display_mode": "files" }
        },
        {
          "type": "dotnet",
          "style": "powerline",
          "powerline_symbol": "",
          "foreground": "#1F2430",
          "background": "#81A1C1",
          "template": "  {{ .Full }} ",
          "properties": { "fetch_version": true, "display_mode": "files" }
        },
        {
          "type": "python",
          "style": "powerline",
          "powerline_symbol": "",
          "foreground": "#1F2430",
          "background": "#FFE082",
          "template": "  {{ if .Error }}{{ .Error }}{{ else }}{{ if .Venv }}{{ .Venv }} {{ end }}{{ .Full }}{{ end }} ",
          "properties": { "fetch_version": true, "display_mode": "files" }
        },
        {
          "type": "go",
          "style": "powerline",
          "powerline_symbol": "",
          "foreground": "#1F2430",
          "background": "#7FDBFF",
          "template": " ﳑ {{ .Full }} ",
          "properties": { "fetch_version": true, "display_mode": "files" }
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "right",
      "segments": [
        {
          "type": "executiontime",
          "style": "diamond",
          "leading_diamond": "",
          "trailing_diamond": "",
          "foreground": "#1F2430",
          "background": "#FFB86C",
          "properties": {
            "threshold": 500,
            "style": "round"
          },
          "template": "  {{ .FormattedMs }} "
        },
        {
          "type": "time",
          "style": "diamond",
          "leading_diamond": " ",
          "trailing_diamond": "",
          "foreground": "#FFFFFF",
          "background": "#5E81AC",
          "properties": { "time_format": "15:04:05" },
          "template": "  {{ .CurrentDate | date .Format }} "
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "status",
          "style": "plain",
          "foreground": "#A3BE8C",
          "foreground_templates": [
            "{{ if gt .Code 0 }}#BF616A{{ end }}"
          ],
          "properties": { "always_enabled": true },
          "template": "❯"
        }
      ]
    }
  ],
  "transient_prompt": {
    "foreground": "#7F848E",
    "template": "❯ "
  },
  "secondary_prompt": {
    "foreground": "#7F848E",
    "template": "❯❯ "
  }
}
